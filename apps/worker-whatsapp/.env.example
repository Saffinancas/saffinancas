# ============================================================================
# Saf Finanças — worker WhatsApp (apps/worker-whatsapp)
# Use no Fly.io: `flyctl secrets set` ou em dev: copie pra .env.local
# ============================================================================

NODE_ENV="production"
PORT="8080"

# Mesmo Postgres da web (Neon). Worker persiste whatsapp_messages, transactions, etc.
DATABASE_URL="postgresql://USER:PASS@ep-XXXX-pooler.sa-east-1.aws.neon.tech/saf?sslmode=require"

# Redis (Upstash) — BullMQ usa pra durabilidade da fila de classificação.
REDIS_URL="rediss://default:PASS@xxx.upstash.io:6379"

# Segredo compartilhado worker ↔ web. Gere com: openssl rand -hex 32
# E coloque o MESMO valor em WHATSAPP_WORKER_SECRET na web (Vercel).
WORKER_SHARED_SECRET=""

# Diretório onde o whatsapp-web.js persiste tokens de sessão (LocalAuth).
# No Fly.io, montar volume nesse caminho — ver fly.toml.
WA_SESSIONS_DIR="/data/wwebjs_auth"

# Retenção de mensagens brutas (LGPD). Default 90 dias.
WA_MESSAGE_TTL_DAYS="90"

# IA (mesmas chaves da web, configuradas pelo admin).
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

# Necessário pra decriptar chaves BYOK de clientes (mesma chave da web).
PLATFORM_ENCRYPTION_KEY=""
