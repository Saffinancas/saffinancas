{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "ES2022"],
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true,
    "allowJs": false,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@cofre/db": ["../../packages/db/src/index.ts"],
      "@cofre/db/*": ["../../packages/db/src/*"],
      "@cofre/ai": ["../../packages/ai/src/index.ts"],
      "@cofre/ai/*": ["../../packages/ai/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
