# --- Banco de dados ---
DATABASE_URL="postgresql://user:password@localhost:5432/cofre"

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET="gere-uma-string-aleatoria-de-32+-caracteres"
BETTER_AUTH_URL="http://localhost:3000"

# --- Provedores de IA (chaves do dono da plataforma, NÃO do cliente) ---
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

# --- Pagar.me v5 ---
PAGARME_API_KEY=""
PAGARME_PUBLIC_KEY=""
PAGARME_WEBHOOK_SECRET=""

# --- Pluggy (Open Finance) ---
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""

# --- Redis (fila BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- Email transacional (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="Cofre <no-reply@example.com>"

# --- Storage de comprovantes (Cloudflare R2) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="cofre-receipts"

# --- Observabilidade ---
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- Worker WhatsApp ---
# Fase 1: whatsapp-web.js (sessão local persistida em volume)
WHATSAPP_SESSION_DIR="./.wwebjs_auth"
# Fase 4: WhatsApp Cloud API (Meta) — preencher quando migrar
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_CLOUD_PHONE_ID=""
WHATSAPP_CLOUD_VERIFY_TOKEN=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
