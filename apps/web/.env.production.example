# ============================================================================
# Saf Finanças — variáveis de ambiente de PRODUÇÃO
# Use este arquivo como referência ao configurar Vercel (Settings → Environment
# Variables). NUNCA commit valores reais. Em dev local, use `.env.local`.
# ============================================================================

# --- Banco de dados (Neon Postgres) ---
# Pegue em neon.tech → Project → Connection details. Marcar "Pooled" pra Vercel.
# Importante: deixe vazio (ou comente) pra cair pra PGlite local em dev.
DATABASE_URL="postgresql://USER:PASS@ep-XXXX-pooler.sa-east-1.aws.neon.tech/saf?sslmode=require"

# --- App URL ---
# Coloque seu domínio real (ou o subdomínio .vercel.app durante testes).
NEXT_PUBLIC_APP_URL="https://saffinancas.com.br"
NODE_ENV="production"

# --- Auth (Better Auth) ---
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="https://saffinancas.com.br"

# --- Criptografia at-rest (chaves BYOK, certificados digitais, etc.) ---
# Gere com: openssl rand -base64 32
PLATFORM_ENCRYPTION_KEY=""

# --- Cron Vercel ---
# Vercel envia esse Bearer no cron diário. Gere com: openssl rand -hex 32
CRON_SECRET=""

# --- Provedores de IA (admin paga, cliente vê via BYOK opcional) ---
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

# --- Pagar.me (cobrança das famílias) ---
PAGARME_API_KEY=""
PAGARME_PUBLIC_KEY=""
PAGARME_WEBHOOK_SECRET=""

# --- Pluggy (Open Finance + Investments) ---
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""

# --- Email transacional (Resend) ---
# resend.com → API Keys. Verifique o domínio antes de enviar pra clientes reais.
RESEND_API_KEY=""
EMAIL_FROM="Saf Finanças <no-reply@saffinancas.com.br>"

# --- Upstash Redis (fila do worker WhatsApp; só precisa quando subir o worker) ---
REDIS_URL=""

# --- Cloudflare R2 (comprovantes WhatsApp + XMLs NFSe) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="saf-attachments"

# --- WhatsApp worker (Fase 1+, deploy em Fly.io) ---
# 'sim' (default) usa simulador. 'real' liga o worker.
WHATSAPP_MODE="sim"
# URL pública do worker (ex.: https://saf-whatsapp.fly.dev). Só usado quando WHATSAPP_MODE=real.
WHATSAPP_WORKER_URL=""
# Mesmo segredo configurado no worker (WORKER_SHARED_SECRET). Gere com: openssl rand -hex 32
WHATSAPP_WORKER_SECRET=""

# --- NFSe providers (pelo menos um pra emitir notas reais) ---
# Focus NFe (recomendado): focusnfe.com.br
FOCUSNFE_TOKEN=""
# Ou PlugNotas: plugnotas.com.br
PLUGNOTAS_API_KEY=""

# --- Observabilidade (opcional) ---
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
